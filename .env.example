# GHOSTWALK environment — copy to .env and fill in privately. Never commit .env.
# Every variable below is OPTIONAL. The app runs with all fallbacks and
# remains fully usable without any key (AI explanation and premium TTS
# gracefully degrade to built-in translated guidance and device voices).

# Server port. The host (e.g. Render) sets this; locally it falls back to 3000.
# Required: no (fallback-only) | Secret: no
PORT=3000

# Optional OpenAI-compatible endpoint for Ghost AI explanations.
# Without a key, every explanation uses the built-in translated packs.
# Required: no (fallback-only) | Secret: yes (API key only)
GHOST_AI_BASE_URL=https://api.openai.com/v1
GHOST_AI_API_KEY=
GHOST_AI_MODEL=gpt-4o-mini
GHOST_AI_TIMEOUT_MS=12000
GHOST_AI_MAX_TOKENS=400

# Optional premium text-to-speech providers. Without keys, GHOSTWALK uses the
# free keyless provider plus on-device browser voices.
# Required: no (fallback-only) | Secret: yes (keys only)
BHASHINI_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs voice id (defaults to Rachel if unset).
# Required: no (fallback-only) | Secret: no
ELEVENLABS_VOICE_ID=
# Set KEYLESS_TTS=0 to disable the free provider and use keys only.
# Required: no (fallback-only) | Secret: no
KEYLESS_TTS=1
